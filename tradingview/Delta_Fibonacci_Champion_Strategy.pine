//@version=5
strategy("Delta Fibonacci Institutional Alpha Strategy [Champion Basket]", 
         shorttitle="Delta Fib Alpha", 
         overlay=true, 
         initial_capital=2500, 
         default_qty_type=strategy.cash, 
         default_qty_value=5, 
         commission_type=strategy.commission.cash_per_order, 
         commission_value=0.05, 
         slippage=1, 
         process_orders_on_close=false)

// ==============================================================================
// 1. INPUTS & CONFIGURATION
// ==============================================================================
grp_model = "Strategy Engine & Champion Preset"
use_auto_detect = input.bool(true, "Auto-Detect Champion Preset by Symbol", group=grp_model, tooltip="Automatically applies the empirically validated champion parameters for the active chart symbol.")
manual_model    = input.string("MODEL_1", "Manual Primary Model", options=["MODEL_1", "MODEL_2", "BOTH"], group=grp_model)
manual_ema      = input.int(55, "Manual Fast EMA Period", minval=10, maxval=400, group=grp_model)
manual_exit     = input.string("fixed_3.0r", "Manual Exit Strategy", options=["fixed_2.0r", "fixed_2.5r", "fixed_3.0r", "fixed_3.5r", "fixed_4.0r", "trail_0.5r", "trail_1.0r", "trail_1.5r"], group=grp_model)

grp_risk = "Risk & Position Sizing"
risk_per_trade_usd = input.float(5.0, "Target Risk per Trade ($ USD)", minval=1.0, group=grp_risk)
sl_atr_mult        = input.float(1.2, "Stop Loss ATR Multiplier", step=0.1, group=grp_risk)
hard_max_cap_usd   = input.float(40.0, "Hard Max Risk Cap ($ USD)", group=grp_risk)

grp_params = "Mechanical 'Kiss EMA & Go Back' Criteria"
kiss_tolerance_atr = input.float(0.15, "EMA Kiss Shelf Tolerance (ATR)", step=0.05, group=grp_params, tooltip="Max distance above EMA for low (Buy) or below EMA for high (Sell) to qualify as touching/kissing the EMA shelf.")
max_pierce_atr     = input.float(0.40, "Max Allowed EMA Pierce (ATR)", step=0.05, group=grp_params, tooltip="Max distance candle wick can pierce through the EMA without invalidating the bounce.")
min_slope_atr      = input.float(0.015, "Min Normalized Slope (ATR/bar)", step=0.005, group=grp_params)
min_wick_pct       = input.float(30.0, "Min Rejection Wick (%)", step=1.0, group=grp_params) / 100.0
require_candle_dir = input.bool(true, "Require Directional Rejection Candle (Green for Long, Red for Short)", group=grp_params)
require_close_half = input.bool(true, "Require Close in Rejection Half of Candle Range", group=grp_params)
kaufman_er_thresh  = input.float(0.18, "Kaufman ER Chop Floor", step=0.02, group=grp_params)
cooldown_bars      = input.int(10, "Post-Exit Cooldown (Bars)", minval=1, group=grp_params)
enable_breakeven   = input.bool(true, "Lock Breakeven at +1.0R MFE", group=grp_params)

// ==============================================================================
// 2. AUTOMATIC CHAMPION PRESET RESOLUTION
// ==============================================================================
f_get_preset() =>
    string t = syminfo.ticker
    string m = manual_model
    int e = manual_ema
    string ex = manual_exit
    float sl = sl_atr_mult

    if use_auto_detect
        if str.contains(t, "SP500") or str.contains(t, "US500") or str.contains(t, "SPX")
            m := "MODEL_1", e := 89, ex := "trail_0.5r", sl := 1.5
        else if str.contains(t, "JP225") or str.contains(t, "NI225") or str.contains(t, "JPN225")
            m := "MODEL_1", e := 65, ex := "trail_0.5r", sl := 1.5
        else if str.contains(t, "DJ30") or str.contains(t, "US30") or str.contains(t, "WS30")
            m := "MODEL_1", e := 55, ex := "trail_0.5r", sl := 1.5
        else if str.contains(t, "NAS100") or str.contains(t, "USTEC") or str.contains(t, "NDX")
            m := "MODEL_1", e := 55, ex := "trail_0.5r", sl := 1.5
        else if str.contains(t, "HK50") or str.contains(t, "HSI")
            m := "MODEL_1", e := 50, ex := "trail_0.5r", sl := 1.5
        else if str.contains(t, "XAUUSD") or str.contains(t, "GOLD")
            m := "MODEL_1", e := 55, ex := "fixed_3.5r", sl := 1.5
        else if str.contains(t, "XAGUSD") or str.contains(t, "SILVER")
            m := "MODEL_1", e := 160, ex := "fixed_4.0r", sl := 1.5
        else if str.contains(t, "USWTI") or str.contains(t, "WTI") or str.contains(t, "OIL")
            m := "MODEL_1", e := 50, ex := "trail_0.5r", sl := 1.5
        else if str.contains(t, "BTCUSD") or str.contains(t, "BTC")
            m := "MODEL_2", e := 233, ex := "fixed_4.0r", sl := 1.5
        else if str.contains(t, "ETHUSD") or str.contains(t, "ETH")
            m := "MODEL_2", e := 89, ex := "fixed_3.5r", sl := 1.5
        else if str.contains(t, "XLMUSD") or str.contains(t, "XLM")
            m := "MODEL_2", e := 65, ex := "fixed_3.5r", sl := 1.5
        else if str.contains(t, "XRPUSD") or str.contains(t, "XRP")
            m := "MODEL_2", e := 89, ex := "trail_0.5r", sl := 1.5
        else if str.contains(t, "ADAUSD") or str.contains(t, "ADA")
            m := "MODEL_1", e := 55, ex := "fixed_4.0r", sl := 1.5
        else if str.contains(t, "USDCAD")
            m := "MODEL_1", e := 55, ex := "fixed_3.0r", sl := 1.5
        else if str.contains(t, "EURUSD")
            m := "MODEL_1", e := 55, ex := "trail_0.5r", sl := 1.5
        else if str.contains(t, "GBPUSD")
            m := "MODEL_2", e := 100, ex := "fixed_3.5r", sl := 1.5
        else if str.contains(t, "USDCHF")
            m := "MODEL_2", e := 400, ex := "trail_0.5r", sl := 1.5
        else if str.contains(t, "GBPJPY")
            m := "MODEL_1", e := 160, ex := "fixed_2.5r", sl := 1.5
        else if str.contains(t, "CADJPY")
            m := "MODEL_1", e := 100, ex := "fixed_2.5r", sl := 1.5
        else if str.contains(t, "CHFJPY")
            m := "MODEL_2", e := 160, ex := "fixed_3.5r", sl := 1.5
        else if str.contains(t, "USDJPY")
            m := "MODEL_2", e := 89, ex := "trail_0.5r", sl := 1.5
        else if str.contains(t, "NZDSGD")
            m := "MODEL_1", e := 100, ex := "fixed_3.5r", sl := 1.5
        else if str.contains(t, "GBPNOK")
            m := "MODEL_2", e := 89, ex := "trail_0.5r", sl := 1.5
    [m, e, ex, sl]

[active_model, active_ema, active_exit, active_sl_mult] = f_get_preset()

// ==============================================================================
// 3. CORE TECHNICAL INDICATORS
// ==============================================================================
// Fast Champion EMA
ema_val = ta.ema(close, active_ema)

// ATR 14
atr_val = ta.atr(14)

// Candle Geometry
candle_rng = high - low
candle_rng_safe = candle_rng > 0 ? candle_rng : syminfo.mintick
lower_wick = (math.min(open, close) - low) / candle_rng_safe
upper_wick = (high - math.max(open, close)) / candle_rng_safe
body_pct   = math.abs(close - open) / candle_rng_safe

// Directional Rejection & Close Placement Filters
is_bullish_candle = close > open
is_bearish_candle = close < open
close_in_upper_half = ((close - low) / candle_rng_safe) >= 0.50
close_in_lower_half = ((high - close) / candle_rng_safe) >= 0.50

// Kaufman Efficiency Ratio (10 bars)
er_direction  = math.abs(close - close[10])
er_volatility = math.sum(ta.tr(true), 10)
kaufman_er    = er_volatility > 0 ? (er_direction / er_volatility) : 0.0

chop_pass = (kaufman_er >= kaufman_er_thresh) or (lower_wick >= 0.35) or (upper_wick >= 0.35)

// ATR-Normalized Slope (4 bars on 1H, 3 bars on 4H/Daily)
slope_lookback = (timeframe.isintraday and timeframe.multiplier <= 60) ? 4 : 3
norm_slope = (atr_val > 0) ? (ema_val - ema_val[slope_lookback]) / (slope_lookback * atr_val) : 0.0

// Prior Trend Continuity (Prior bar was on the proper trend side of EMA)
prior_above_ema = close[1] > ema_val[1]
prior_below_ema = close[1] < ema_val[1]

// Post-Exit Cooldown State Tracker
var int last_exit_bar = -999
if strategy.position_size[1] != 0 and strategy.position_size == 0
    last_exit_bar := bar_index

in_cooldown = (bar_index - last_exit_bar) <= cooldown_bars

// ==============================================================================
// 4. MODEL 1: SURGICAL "KISS EMA & GO BACK" REJECTION
// ==============================================================================
bool m1_buy_signal = false
bool m1_sell_signal = false

if (active_model == "MODEL_1" or active_model == "BOTH")
    // Long "Kiss & Go Back":
    // 1. Upward trend: EMA slope >= min_slope and prior bar above EMA
    // 2. Kiss: Low tests EMA shelf within tolerance (low <= EMA + kiss_tolerance and low >= EMA - max_pierce)
    // 3. Go Back: Closes above EMA, bullish candle (close > open), lower wick >= min_wick_pct, closes in upper half
    bool long_trend_ok  = (norm_slope >= min_slope_atr) and prior_above_ema
    bool long_kiss_ok   = (low <= ema_val + kiss_tolerance_atr * atr_val) and (low >= ema_val - max_pierce_atr * atr_val)
    bool long_go_back   = (close > ema_val) and (require_candle_dir ? is_bullish_candle : true) and (lower_wick >= min_wick_pct) and (require_close_half ? close_in_upper_half : true)
    
    if long_trend_ok and long_kiss_ok and long_go_back
        m1_buy_signal := true

    // Short "Kiss & Go Back":
    // 1. Downward trend: EMA slope <= -min_slope and prior bar below EMA
    // 2. Kiss: High tests EMA shelf within tolerance (high >= EMA - kiss_tolerance and high <= EMA + max_pierce)
    // 3. Go Back: Closes below EMA, bearish candle (close < open), upper wick >= min_wick_pct, closes in lower half
    bool short_trend_ok = (norm_slope <= -min_slope_atr) and prior_below_ema
    bool short_kiss_ok  = (high >= ema_val - kiss_tolerance_atr * atr_val) and (high <= ema_val + max_pierce_atr * atr_val)
    bool short_go_back  = (close < ema_val) and (require_candle_dir ? is_bearish_candle : true) and (upper_wick >= min_wick_pct) and (require_close_half ? close_in_lower_half : true)
    
    if short_trend_ok and short_kiss_ok and short_go_back
        m1_sell_signal := true

// ==============================================================================
// 5. MODEL 2: MACRO DWELL & RECLAIM SPRING CRITERIA
// ==============================================================================
bool m2_buy_signal = false
bool m2_sell_signal = false

int dwell_lb   = (timeframe.isintraday and timeframe.multiplier <= 60) ? 100 : 35
int min_dwell  = (timeframe.isintraday and timeframe.multiplier <= 60) ? 12 : 3
int max_dwell  = (timeframe.isintraday and timeframe.multiplier <= 60) ? 60 : 25
float m2_clearance = 0.10 * atr_val

int count_below = 0
int count_above = 0
for b = 1 to dwell_lb
    if close[b] < ema_val[b]
        count_below += 1
    if close[b] > ema_val[b]
        count_above += 1

if (active_model == "MODEL_2" or active_model == "BOTH")
    if ema_val >= ema_val[3] * 0.999 and lower_wick >= 0.33
        if low <= ema_val and close >= (ema_val + m2_clearance) and is_bullish_candle
            if count_below >= min_dwell and count_below <= max_dwell
                m2_buy_signal := true

    if ema_val <= ema_val[3] * 1.001 and upper_wick >= 0.33
        if high >= ema_val and close <= (ema_val - m2_clearance) and is_bearish_candle
            if count_above >= min_dwell and count_above <= max_dwell
                m2_sell_signal := true

// Combine signals with Anti-Chop & Anti-Whipsaw gates
valid_long_setup  = (m1_buy_signal or m2_buy_signal) and chop_pass and not in_cooldown and (strategy.position_size == 0)
valid_short_setup = (m1_sell_signal or m2_sell_signal) and chop_pass and not in_cooldown and (strategy.position_size == 0)

// ==============================================================================
// 6. POSITION EXECUTION & DYNAMIC RISK TRAILING
// ==============================================================================
var float entry_price_val = na
var float stop_loss_val   = na
var float take_profit_val = na
var float risk_dist_val   = na
var float peak_mfe_r      = 0.0

// Calculate Target Multiple based on Champion Exit Strategy
f_get_target_rr(string mode) =>
    switch mode
        "trail_1.5r" => 8.0
        "trail_1.0r" => 6.0
        "trail_0.5r" => 5.0
        "fixed_4.0r" => 4.0
        "fixed_3.5r" => 3.5
        "fixed_3.0r" => 3.0
        "fixed_2.5r" => 2.5
        "fixed_2.0r" => 2.0
        => 2.5

float target_rr = f_get_target_rr(active_exit)

// Entry Triggers (Strictly causal on next bar open)
if valid_long_setup
    risk_dist_val   := active_sl_mult * atr_val
    entry_price_val := close
    stop_loss_val   := close - risk_dist_val
    take_profit_val := close + target_rr * risk_dist_val
    peak_mfe_r      := 0.0

    // Position sizing: $5 target risk / risk_dist, subject to min lot and $40 cap
    float qty = risk_dist_val > 0 ? (risk_per_trade_usd / risk_dist_val) : 1.0
    strategy.entry("Long", strategy.long, qty=qty)

if valid_short_setup
    risk_dist_val   := active_sl_mult * atr_val
    entry_price_val := close
    stop_loss_val   := close + risk_dist_val
    take_profit_val := close - target_rr * risk_dist_val
    peak_mfe_r      := 0.0

    float qty = risk_dist_val > 0 ? (risk_per_trade_usd / risk_dist_val) : 1.0
    strategy.entry("Short", strategy.short, qty=qty)

// Active Position Management (Evaluated while in trade)
if strategy.position_size > 0
    float cur_favorable = high - strategy.position_avg_price
    float cur_mfe_r = (risk_dist_val > 0) ? (cur_favorable / risk_dist_val) : 0.0
    peak_mfe_r := math.max(peak_mfe_r, cur_mfe_r)

    // Breakeven Lock at +1.0R
    if enable_breakeven and peak_mfe_r >= 1.0
        stop_loss_val := math.max(stop_loss_val, strategy.position_avg_price)

    // Dynamic Ratchet Trailing Stops
    if active_exit == "trail_0.5r" and peak_mfe_r >= 1.5
        float locked_r = peak_mfe_r - 0.5
        float trail_stop = strategy.position_avg_price + locked_r * risk_dist_val
        stop_loss_val := math.max(stop_loss_val, trail_stop)
    else if active_exit == "trail_1.0r" and peak_mfe_r >= 2.0
        float locked_r = peak_mfe_r - 1.0
        float trail_stop = strategy.position_avg_price + locked_r * risk_dist_val
        stop_loss_val := math.max(stop_loss_val, trail_stop)
    else if active_exit == "trail_1.5r" and peak_mfe_r >= 2.5
        float locked_r = peak_mfe_r - 1.5
        float trail_stop = strategy.position_avg_price + locked_r * risk_dist_val
        stop_loss_val := math.max(stop_loss_val, trail_stop)

    strategy.exit("Exit Long", from_entry="Long", stop=stop_loss_val, limit=take_profit_val)

else if strategy.position_size < 0
    float cur_favorable = strategy.position_avg_price - low
    float cur_mfe_r = (risk_dist_val > 0) ? (cur_favorable / risk_dist_val) : 0.0
    peak_mfe_r := math.max(peak_mfe_r, cur_mfe_r)

    // Breakeven Lock at +1.0R
    if enable_breakeven and peak_mfe_r >= 1.0
        stop_loss_val := math.min(stop_loss_val, strategy.position_avg_price)

    // Dynamic Ratchet Trailing Stops
    if active_exit == "trail_0.5r" and peak_mfe_r >= 1.5
        float locked_r = peak_mfe_r - 0.5
        float trail_stop = strategy.position_avg_price - locked_r * risk_dist_val
        stop_loss_val := math.min(stop_loss_val, trail_stop)
    else if active_exit == "trail_1.0r" and peak_mfe_r >= 2.0
        float locked_r = peak_mfe_r - 1.0
        float trail_stop = strategy.position_avg_price - locked_r * risk_dist_val
        stop_loss_val := math.min(stop_loss_val, trail_stop)
    else if active_exit == "trail_1.5r" and peak_mfe_r >= 2.5
        float locked_r = peak_mfe_r - 1.5
        float trail_stop = strategy.position_avg_price - locked_r * risk_dist_val
        stop_loss_val := math.min(stop_loss_val, trail_stop)

    strategy.exit("Exit Short", from_entry="Short", stop=stop_loss_val, limit=take_profit_val)

// ==============================================================================
// 7. VISUALIZATIONS & HUD OVERLAY
// ==============================================================================
// Fast EMA with slope color coding
color ema_color = norm_slope >= min_slope_atr ? color.new(color.green, 0) : 
                  norm_slope <= -min_slope_atr ? color.new(color.red, 0) : 
                  color.new(color.gray, 50)
plot(ema_val, "Champion Fast EMA", color=ema_color, linewidth=2)

// Shelf Tolerance Bands
p_shelf_top = plot(ema_val + kiss_tolerance_atr * atr_val, "Kiss Shelf Upper", color=color.new(color.teal, 80), style=plot.style_circles)
p_shelf_bot = plot(ema_val - kiss_tolerance_atr * atr_val, "Kiss Shelf Lower", color=color.new(color.teal, 80), style=plot.style_circles)
fill(p_shelf_top, p_shelf_bot, color=color.new(color.teal, 92), title="EMA Kiss Shelf")

// Signal Plots
plotshape(valid_long_setup, "Long Setup Confirmed", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(valid_short_setup, "Short Setup Confirmed", shape.triangledown, location.abovebar, color.red, size=size.small)

// Live Target & Stop Lines when in Trade
plot(strategy.position_size != 0 ? stop_loss_val : na, "Active Stop Loss", color=color.red, style=plot.style_linebr, linewidth=2)
plot(strategy.position_size != 0 ? take_profit_val : na, "Active Take Profit", color=color.green, style=plot.style_linebr, linewidth=2)

// Tactical HUD Table in Top-Right
var table hud = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 20), border_color=color.gray, border_width=1)
if barstate.islast
    table.cell(hud, 0, 0, "Champion Asset", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 0, syminfo.ticker, bgcolor=color.navy, text_color=color.yellow, text_size=size.small)
    
    table.cell(hud, 0, 1, "Active Model", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 1, active_model, text_color=color.white, text_size=size.small)
    
    table.cell(hud, 0, 2, "Fast EMA", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 2, str.tostring(active_ema), text_color=color.aqua, text_size=size.small)
    
    table.cell(hud, 0, 3, "Exit Mode", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 3, active_exit, text_color=color.orange, text_size=size.small)
    
    table.cell(hud, 0, 4, "SL Mult (ATR)", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 4, str.tostring(active_sl_mult, "#.#"), text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 5, "Normalized Slope", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 5, str.tostring(norm_slope, "#.####") + " ATR/b", text_color=norm_slope >= min_slope_atr ? color.green : norm_slope <= -min_slope_atr ? color.red : color.gray, text_size=size.small)
    
    table.cell(hud, 0, 6, "Kaufman ER (10)", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 6, str.tostring(kaufman_er, "#.##"), text_color=chop_pass ? color.green : color.red, text_size=size.small)
    
    table.cell(hud, 0, 7, "Cooldown Status", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 7, in_cooldown ? "In Cooldown (" + str.tostring(bar_index - last_exit_bar) + "/" + str.tostring(cooldown_bars) + ")" : "Active Ready", text_color=in_cooldown ? color.orange : color.green, text_size=size.small)
