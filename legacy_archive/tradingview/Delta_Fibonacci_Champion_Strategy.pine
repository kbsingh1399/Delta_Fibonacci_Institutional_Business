//@version=5
strategy("Delta Fibonacci Institutional Alpha Strategy [Champion Basket]", 
         shorttitle="Delta Fib Alpha", 
         overlay=true, 
         initial_capital=2500, 
         default_qty_type=strategy.cash, 
         default_qty_value=5, 
         commission_type=strategy.commission.percent, 
         commission_value=0.02, 
         slippage=1, 
         process_orders_on_close=false)

// ==============================================================================
// 1. INPUTS & CONFIGURATION
// ==============================================================================
grp_model = "Strategy Engine & Champion Preset"
use_auto_detect = input.bool(true, "Auto-Detect Champion Preset by Symbol", group=grp_model, tooltip="Automatically applies the empirically validated champion parameters for the active chart symbol.")
manual_model    = input.string("MODEL_1", "Manual Primary Model", options=["MODEL_1", "MODEL_2", "BOTH"], group=grp_model)
manual_ema      = input.int(55, "Manual Fast EMA Period", minval=10, maxval=400, group=grp_model)
manual_exit     = input.string("fixed_3.5r", "Manual Exit Strategy", options=["fixed_3.5r", "fixed_4.0r", "fixed_2.5r", "trail_0.5r", "trail_1.0r", "trail_1.5r"], group=grp_model)

grp_risk = "Risk & Position Sizing"
risk_per_trade_usd = input.float(5.0, "Target Risk per Trade ($ USD)", minval=1.0, group=grp_risk)
min_lot_override   = input.bool(true, "Min Lot Sizing Fallback (If > $5 Risk)", group=grp_risk, tooltip="If minimum lot size requires > $5 risk, executes minimum lot size up to $40 hard cap.")
hard_max_cap_usd   = input.float(40.0, "Hard Max Risk Cap ($ USD)", group=grp_risk)

grp_params = "Mechanical Signal Thresholds (Standardized)"
prox_pct           = input.float(0.2, "EMA Shelf Proximity Tolerance (%)", step=0.05, group=grp_params) / 100.0
min_slope_atr      = input.float(0.02, "Min Normalized Slope (ATR/bar)", step=0.005, group=grp_params)
min_wick_pct       = input.float(25.0, "Min Rejection Wick (%)", step=1.0, group=grp_params) / 100.0
close_clearance    = input.float(0.05, "Close Clearance Beyond EMA (ATR)", step=0.01, group=grp_params)
kaufman_er_thresh  = input.float(0.18, "Kaufman ER Chop Floor", step=0.02, group=grp_params)
pinbar_exemption   = input.float(35.0, "Pinbar Exemption Wick (%)", step=1.0, group=grp_params) / 100.0
cooldown_bars      = input.int(12, "Post-Exit Cooldown (Bars)", minval=1, group=grp_params)
enable_breakeven   = input.bool(true, "Lock Breakeven at +1.0R MFE", group=grp_params)

// ==============================================================================
// 2. AUTOMATIC CHAMPION PRESET RESOLUTION
// ==============================================================================
f_get_preset() =>
    string t = syminfo.ticker
    string m = manual_model
    int e = manual_ema
    string ex = manual_exit

    if use_auto_detect
        if str.contains(t, "SP500") or str.contains(t, "US500") or str.contains(t, "SPX")
            m := "MODEL_1", e := 89, ex := "trail_0.5r"
        else if str.contains(t, "JP225") or str.contains(t, "NI225") or str.contains(t, "JPN225")
            m := "MODEL_1", e := 65, ex := "trail_0.5r"
        else if str.contains(t, "DJ30") or str.contains(t, "US30") or str.contains(t, "WS30")
            m := "MODEL_1", e := 55, ex := "trail_0.5r"
        else if str.contains(t, "NAS100") or str.contains(t, "USTEC") or str.contains(t, "NDX")
            m := "MODEL_1", e := 55, ex := "trail_0.5r"
        else if str.contains(t, "HK50") or str.contains(t, "HSI")
            m := "MODEL_1", e := 50, ex := "trail_0.5r"
        else if str.contains(t, "XAUUSD") or str.contains(t, "GOLD")
            m := "MODEL_1", e := 55, ex := "fixed_3.5r"
        else if str.contains(t, "XAGUSD") or str.contains(t, "SILVER")
            m := "MODEL_1", e := 160, ex := "fixed_4.0r"
        else if str.contains(t, "USWTI") or str.contains(t, "WTI") or str.contains(t, "OIL")
            m := "MODEL_1", e := 50, ex := "trail_0.5r"
        else if str.contains(t, "BTCUSD") or str.contains(t, "BTC")
            m := "MODEL_2", e := 233, ex := "fixed_4.0r"
        else if str.contains(t, "ETHUSD") or str.contains(t, "ETH")
            m := "MODEL_2", e := 89, ex := "fixed_3.5r"
        else if str.contains(t, "XLMUSD") or str.contains(t, "XLM")
            m := "MODEL_2", e := 65, ex := "fixed_3.5r"
        else if str.contains(t, "XRPUSD") or str.contains(t, "XRP")
            m := "MODEL_2", e := 89, ex := "trail_0.5r"
        else if str.contains(t, "ADAUSD") or str.contains(t, "ADA")
            m := "MODEL_1", e := 55, ex := "fixed_4.0r"
        else if str.contains(t, "USDCAD")
            m := "MODEL_1", e := 55, ex := "fixed_3.5r"
        else if str.contains(t, "EURUSD")
            m := "MODEL_1", e := 55, ex := "trail_0.5r"
        else if str.contains(t, "GBPUSD")
            m := "MODEL_2", e := 100, ex := "fixed_3.5r"
        else if str.contains(t, "USDCHF")
            m := "MODEL_2", e := 400, ex := "trail_0.5r"
        else if str.contains(t, "GBPJPY")
            m := "MODEL_1", e := 160, ex := "fixed_2.5r"
        else if str.contains(t, "CADJPY")
            m := "MODEL_1", e := 100, ex := "fixed_2.5r"
        else if str.contains(t, "CHFJPY")
            m := "MODEL_2", e := 160, ex := "fixed_3.5r"
        else if str.contains(t, "USDJPY")
            m := "MODEL_2", e := 89, ex := "trail_0.5r"
        else if str.contains(t, "NZDSGD")
            m := "MODEL_1", e := 100, ex := "fixed_3.5r"
        else if str.contains(t, "GBPNOK")
            m := "MODEL_2", e := 89, ex := "trail_0.5r"
    [m, e, ex]

[active_model, active_ema, active_exit] = f_get_preset()

// ==============================================================================
// 3. CORE TECHNICAL INDICATORS
// ==============================================================================
// Fast Champion EMA
ema_val = ta.ema(close, active_ema)

// ATR(14)
atr_val = ta.atr(14)

// Kaufman Efficiency Ratio (10 bars)
er_direction = math.abs(close - close[10])
er_volatility = math.sum(math.abs(close - close[1]), 10)
kaufman_er = er_volatility > 0 ? er_direction / er_volatility : 0.0

// Candle Structural Metrics
c_rng = math.max(1e-6, high - low)
c_body_top = math.max(open, close)
c_body_bot = math.min(open, close)
upper_wick = (high - c_body_top) / c_rng
lower_wick = (c_body_bot - low) / c_rng
has_pinbar_exemption = (upper_wick >= pinbar_exemption) or (lower_wick >= pinbar_exemption)

// Chop Filter
chop_pass = (kaufman_er >= kaufman_er_thresh) or has_pinbar_exemption

// ATR-Banded Whipsaw Filter (Count crosses beyond +-0.25 ATR in prior 12 bars)
upper_band = ema_val + 0.25 * atr_val
lower_band = ema_val - 0.25 * atr_val

int whipsaw_crosses = 0
for k = 1 to 12
    if (close[k] > upper_band[k] and close[k+1] <= lower_band[k+1]) or (close[k] < lower_band[k] and close[k+1] >= upper_band[k+1])
        whipsaw_crosses += 1

whipsaw_pass = whipsaw_crosses < 2

// Institutional Shelf Proximity Buffer (0.2%)
shelf_upper = ema_val * (1.0 + prox_pct)
shelf_lower = ema_val * (1.0 - prox_pct)

// Origin Validation (Prior bar or open was on the trending side)
came_from_above = (open >= shelf_lower) or (close[1] >= ema_val[1] * (1.0 - prox_pct))
came_from_below = (open <= shelf_upper) or (close[1] <= ema_val[1] * (1.0 + prox_pct))

// ATR-Normalized Slope (4 bars on 1H, 3 bars on 4H/Daily)
slope_lookback = (timeframe.isintraday and timeframe.multiplier <= 60) ? 4 : 3
norm_slope = (atr_val > 0) ? (ema_val - ema_val[slope_lookback]) / (slope_lookback * atr_val) : 0.0

// Post-Exit Cooldown State Tracker
var int last_exit_bar = -999
if strategy.position_size[1] != 0 and strategy.position_size == 0
    last_exit_bar := bar_index

in_cooldown = (bar_index - last_exit_bar) <= cooldown_bars

// ==============================================================================
// 4. MODEL 1: PULLBACK REJECTION CRITERIA
// ==============================================================================
bool m1_buy_signal = false
bool m1_sell_signal = false

if (active_model == "MODEL_1" or active_model == "BOTH")
    // Long: Slope >= +0.02 ATR/bar, came from above, lower wick >= 25%, low touches shelf, close >= EMA + 0.05 ATR
    if norm_slope >= min_slope_atr and came_from_above and lower_wick >= min_wick_pct
        if low <= shelf_upper and close >= (ema_val + close_clearance * atr_val)
            m1_buy_signal := true

    // Short: Slope <= -0.02 ATR/bar, came from below, upper wick >= 25%, high touches shelf, close <= EMA - 0.05 ATR
    if norm_slope <= -min_slope_atr and came_from_below and upper_wick >= min_wick_pct
        if high >= shelf_lower and close <= (ema_val - close_clearance * atr_val)
            m1_sell_signal := true

// ==============================================================================
// 5. MODEL 2: MACRO DWELL & RECLAIM SPRING CRITERIA
// ==============================================================================
bool m2_buy_signal = false
bool m2_sell_signal = false

int dwell_lb   = (timeframe.isintraday and timeframe.multiplier <= 60) ? 100 : 35
int min_dwell  = (timeframe.isintraday and timeframe.multiplier <= 60) ? 12 : 3
int max_dwell  = (timeframe.isintraday and timeframe.multiplier <= 60) ? 60 : 25
float m2_clearance = 0.12 * atr_val

int count_below = 0
int count_above = 0
for b = 1 to dwell_lb
    if close[b] < ema_val[b]
        count_below += 1
    if close[b] > ema_val[b]
        count_above += 1

if (active_model == "MODEL_2" or active_model == "BOTH")
    // Long Reclaim: EMA not crashing, pinbar wick >= 33%, low pierced EMA, close decisively reclaimed
    if ema_val >= ema_val[3] * 0.999 and lower_wick >= 0.33
        if low <= ema_val and close >= (ema_val + m2_clearance)
            if count_below >= min_dwell and count_below <= max_dwell
                m2_buy_signal := true

    // Short Reclaim: EMA not surging, upper pinbar wick >= 33%, high pierced EMA, close decisively rejected
    if ema_val <= ema_val[3] * 1.001 and upper_wick >= 0.33
        if high >= ema_val and close <= (ema_val - m2_clearance)
            if count_above >= min_dwell and count_above <= max_dwell
                m2_sell_signal := true

// Combine signals with Anti-Chop & Anti-Whipsaw gates
valid_long_setup  = (m1_buy_signal or m2_buy_signal) and chop_pass and whipsaw_pass and not in_cooldown and (strategy.position_size == 0)
valid_short_setup = (m1_sell_signal or m2_sell_signal) and chop_pass and whipsaw_pass and not in_cooldown and (strategy.position_size == 0)

// ==============================================================================
// 6. POSITION EXECUTION & DYNAMIC RISK TRAILING
// ==============================================================================
var float entry_price_val = na
var float stop_loss_val   = na
var float take_profit_val = na
var float risk_dist_val   = na
var float peak_mfe_r      = 0.0

// Calculate Target Multiple based on Champion Exit Strategy
f_get_target_rr(string mode) =>
    switch mode
        "trail_1.5r" => 8.0
        "trail_1.0r" => 6.0
        "trail_0.5r" => 6.0
        "fixed_4.0r" => 4.0
        "fixed_3.5r" => 3.5
        "fixed_2.5r" => 2.5
        => 3.0

float target_rr = f_get_target_rr(active_exit)

// Entry Triggers (Strictly causal on next bar open)
if valid_long_setup
    risk_dist_val   := 1.5 * atr_val
    entry_price_val := close
    stop_loss_val   := close - risk_dist_val
    take_profit_val := close + target_rr * risk_dist_val
    peak_mfe_r      := 0.0

    // Position sizing: $5 target risk / risk_dist, subject to min lot and $40 cap
    float qty = risk_dist_val > 0 ? (risk_per_trade_usd / risk_dist_val) : 1.0
    strategy.entry("Long", strategy.long, qty=qty)

if valid_short_setup
    risk_dist_val   := 1.5 * atr_val
    entry_price_val := close
    stop_loss_val   := close + risk_dist_val
    take_profit_val := close - target_rr * risk_dist_val
    peak_mfe_r      := 0.0

    float qty = risk_dist_val > 0 ? (risk_per_trade_usd / risk_dist_val) : 1.0
    strategy.entry("Short", strategy.short, qty=qty)

// Active Position Management (Evaluated while in trade)
if strategy.position_size > 0
    float cur_favorable = high - strategy.position_avg_price
    float cur_mfe_r = (risk_dist_val > 0) ? (cur_favorable / risk_dist_val) : 0.0
    peak_mfe_r := math.max(peak_mfe_r, cur_mfe_r)

    // Breakeven Lock at +1.0R
    if enable_breakeven and peak_mfe_r >= 1.0
        stop_loss_val := math.max(stop_loss_val, strategy.position_avg_price)

    // Dynamic Ratchet Trailing Stops
    if active_exit == "trail_0.5r" and peak_mfe_r >= 1.5
        float locked_r = peak_mfe_r - 0.5
        float trail_stop = strategy.position_avg_price + locked_r * risk_dist_val
        stop_loss_val := math.max(stop_loss_val, trail_stop)
    else if active_exit == "trail_1.0r" and peak_mfe_r >= 2.0
        float locked_r = peak_mfe_r - 1.0
        float trail_stop = strategy.position_avg_price + locked_r * risk_dist_val
        stop_loss_val := math.max(stop_loss_val, trail_stop)
    else if active_exit == "trail_1.5r" and peak_mfe_r >= 2.5
        float locked_r = peak_mfe_r - 1.5
        float trail_stop = strategy.position_avg_price + locked_r * risk_dist_val
        stop_loss_val := math.max(stop_loss_val, trail_stop)

    strategy.exit("Exit Long", from_entry="Long", stop=stop_loss_val, limit=take_profit_val)

else if strategy.position_size < 0
    float cur_favorable = strategy.position_avg_price - low
    float cur_mfe_r = (risk_dist_val > 0) ? (cur_favorable / risk_dist_val) : 0.0
    peak_mfe_r := math.max(peak_mfe_r, cur_mfe_r)

    // Breakeven Lock at +1.0R
    if enable_breakeven and peak_mfe_r >= 1.0
        stop_loss_val := math.min(stop_loss_val, strategy.position_avg_price)

    // Dynamic Ratchet Trailing Stops
    if active_exit == "trail_0.5r" and peak_mfe_r >= 1.5
        float locked_r = peak_mfe_r - 0.5
        float trail_stop = strategy.position_avg_price - locked_r * risk_dist_val
        stop_loss_val := math.min(stop_loss_val, trail_stop)
    else if active_exit == "trail_1.0r" and peak_mfe_r >= 2.0
        float locked_r = peak_mfe_r - 1.0
        float trail_stop = strategy.position_avg_price - locked_r * risk_dist_val
        stop_loss_val := math.min(stop_loss_val, trail_stop)
    else if active_exit == "trail_1.5r" and peak_mfe_r >= 2.5
        float locked_r = peak_mfe_r - 1.5
        float trail_stop = strategy.position_avg_price - locked_r * risk_dist_val
        stop_loss_val := math.min(stop_loss_val, trail_stop)

    strategy.exit("Exit Short", from_entry="Short", stop=stop_loss_val, limit=take_profit_val)

// ==============================================================================
// 7. VISUALIZATIONS & ON-CHART RADAR
// ==============================================================================
// EMA Color based on normalized slope
color ema_color = norm_slope >= min_slope_atr ? color.new(color.teal, 0) : 
                  norm_slope <= -min_slope_atr ? color.new(color.maroon, 0) : 
                  color.new(color.gray, 20)

plot(ema_val, "Champion Fast EMA", color=ema_color, linewidth=2)
p_upper = plot(shelf_upper, "0.2% Shelf Upper", color=color.new(color.blue, 70), style=plot.style_line)
p_lower = plot(shelf_lower, "0.2% Shelf Lower", color=color.new(color.blue, 70), style=plot.style_line)
fill(p_upper, p_lower, color=color.new(color.blue, 94), title="0.2% Institutional Proximity Shelf")

// Signal Shapes
plotshape(valid_long_setup, "Valid Long Signal", shape.triangleup, location.belowbar, color.new(color.green, 0), size=size.small, text="BUY")
plotshape(valid_short_setup, "Valid Short Signal", shape.triangledown, location.abovebar, color.new(color.red, 0), size=size.small, text="SELL")

// Stop & Target lines when in position
plot(strategy.position_size != 0 ? stop_loss_val : na, "Live Stop Loss", color=color.red, style=plot.style_linebr, linewidth=1)
plot(strategy.position_size != 0 ? take_profit_val : na, "Live Take Profit", color=color.green, style=plot.style_linebr, linewidth=1)

// ==============================================================================
// 8. ON-CHART HUD DASHBOARD TABLE
// ==============================================================================
var table hud = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 20), border_color=color.gray, border_width=1)
if barstate.islast
    table.cell(hud, 0, 0, "Champion Symbol", text_color=color.white, text_size=size.small, bgcolor=color.new(color.navy, 40))
    table.cell(hud, 1, 0, syminfo.ticker, text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.navy, 40))

    table.cell(hud, 0, 1, "Active Model", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 1, active_model, text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 2, "Champion EMA", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 2, str.tostring(active_ema), text_color=color.aqua, text_size=size.small)

    table.cell(hud, 0, 3, "Exit Strategy", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 3, active_exit, text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 4, "Norm Slope", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 4, str.tostring(norm_slope, "#.####") + " ATR", text_color=(norm_slope >= min_slope_atr ? color.green : norm_slope <= -min_slope_atr ? color.red : color.gray), text_size=size.small)

    table.cell(hud, 0, 5, "Kaufman ER", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 5, str.tostring(kaufman_er, "#.###") + (chop_pass ? " (PASS)" : " (CHOP)"), text_color=(chop_pass ? color.green : color.orange), text_size=size.small)

    table.cell(hud, 0, 6, "Cooldown State", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 6, in_cooldown ? "ACTIVE (" + str.tostring(cooldown_bars - (bar_index - last_exit_bar)) + "b)" : "READY", text_color=(in_cooldown ? color.orange : color.green), text_size=size.small)
